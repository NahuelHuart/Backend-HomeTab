{% extends 'base.html.twig' %}

{% block title %}
  Gestió d'Usuaris - Admin
{% endblock %}

{% block body %}
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="display-6">
    <i class="bi bi-people text-primary"></i>
    Gestió d'Usuaris
  </h1>
  <a href="{{ path('app_admin_user_new') }}" class="btn btn-primary">
    <i class="bi bi-person-plus"></i> Nou Usuari
  </a>
</div>

<div class="card">
  <div class="card-body">
    <div class="table-responsive">
      <table class="table table-hover align-middle">
        <thead class="table-light">
          <tr>
            <th>ID</th>
            <th>Nom Complet</th>
            <th>Email</th>
            <th>Telèfon</th>
            <th>Data d'entrada</th>
            <th>Rol</th>
            <th>Estat</th>
            <th class="text-end">Accions</th>
          </tr>
        </thead>

        <tbody>
        {% for user in users %}
          <tr>
            <td><strong>#{{ user.id }}</strong></td>

            <td>
              <div class="d-flex align-items-center">
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2"
                     style="width:40px;height:40px;">
                  <strong>{{ user.firstName|slice(0,1)|upper }}{{ user.lastName|slice(0,1)|upper }}</strong>
                </div>
                <div>
                  <strong>{{ user.fullName }}</strong>
                  {% if user.bio %}
                    <br><small class="text-muted">{{ user.bio|slice(0,50) }}…</small>
                  {% endif %}
                </div>
              </div>
            </td>

            <td>{{ user.email }}</td>

            <td>
              {% if user.phoneNumber %}
                <i class="bi bi-telephone"></i> {{ user.phoneNumber }}
              {% else %}
                <span class="text-muted">-</span>
              {% endif %}
            </td>

            <td><small class="text-muted">{{ user.joinedAt|date('d/m/Y') }}</small></td>

            <td>
              {% if 'ROLE_ADMIN' in user.roles %}
                <span class="badge bg-danger"><i class="bi bi-shield-fill"></i> Admin</span>
              {% else %}
                <span class="badge bg-info"><i class="bi bi-person"></i> User</span>
              {% endif %}
            </td>

            <td>
              {% if user.isActive %}
                <span class="badge bg-success"><i class="bi bi-check-circle"></i> Actiu</span>
              {% else %}
                <span class="badge bg-secondary"><i class="bi bi-x-circle"></i> Inactiu</span>
              {% endif %}
            </td>

            <td class="text-end">
              <div class="btn-group btn-group-sm">
                <a href="{{ path('app_admin_user_edit', {id: user.id}) }}"
                   class="btn btn-outline-primary"
                   title="Editar">
                  <i class="bi bi-pencil"></i>
                </a>

                {% if user.id != app.user.id %}
                  <button
                    class="btn btn-outline-danger"
                    data-bs-toggle="modal"
                    data-bs-target="#deleteUserModal"
                    data-user-id="{{ user.id }}"
                    data-user-name="{{ user.fullName }}"
                    title="Esborrar">
                    <i class="bi bi-trash"></i>
                  </button>
                {% endif %}
              </div>
            </td>
          </tr>
        {% endfor %}
        </tbody>
      </table>
    </div>
  </div>
</div>

{# ===================== MODAL =================== #}
<div class="modal fade" id="deleteUserModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">

      <div class="modal-header">
        <h5 class="modal-title">Confirmar Esborrat</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body">
        <p>
          Estàs segur que vols esborrar l'usuari
          <strong id="deleteUserName"></strong>?
        </p>
        <p class="text-danger">
          <i class="bi bi-exclamation-triangle"></i>
          Aquesta acció no es pot desfer!
        </p>
      </div>

      <div class="modal-footer">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
          Cancel·lar
        </button>

        <form method="post" id="deleteUserForm">
          <input type="hidden" name="_token" id="deleteUserToken">
          <button type="submit" class="btn btn-danger">
            <i class="bi bi-trash"></i> Esborrar
          </button>
        </form>
      </div>

    </div>
  </div>
</div>

{# ===================== JS ===================== #}
<script>
document.getElementById('deleteUserModal')
  .addEventListener('show.bs.modal', function (event) {

    const button = event.relatedTarget;
    const userId = button.getAttribute('data-user-id');
    const userName = button.getAttribute('data-user-name');

    document.getElementById('deleteUserName').textContent = userName;

    const form = document.getElementById('deleteUserForm');
    form.action = '/admin/users/' + userId + '/delete';

    document.getElementById('deleteUserToken').value =
      '{{ csrf_token('delete') }}' + userId;
});
</script>

{% endblock %}
