{% extends 'base.html.twig' %}

{% block title %}{% if user.id %}Editar{% else %}Nou{% endif %} Usuari - Admin{% endblock %}

{% block body %}
<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="bi bi-{% if user.id %}pencil{% else %}person-plus{% endif %}"></i>
                    {% if user.id %}Editar Usuari{% else %}Nou Usuari{% endif %}
                </h4>
            </div>
            <div class="card-body">
                {{ form_start(form) }}
                
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.firstName, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.firstName) }}
                        {{ form_errors(form.firstName) }}
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.lastName, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.lastName) }}
                        {{ form_errors(form.lastName) }}
                    </div>
                </div>
                
                <div class="mb-3">
                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.email) }}
                    {{ form_errors(form.email) }}
                </div>

                {# Phone number optional #}
                {% if form.phoneNumber is defined %}
                    <div class="mb-3">
                        {{ form_label(form.phoneNumber, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.phoneNumber) }}
                        {{ form_errors(form.phoneNumber) }}
                    </div>
                {% endif %}

                {# Bio optional #}
                {% if form.bio is defined %}
                    <div class="mb-3">
                        {{ form_label(form.bio, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.bio) }}
                        {{ form_errors(form.bio) }}
                    </div>
                {% endif %}
                
                <div class="mb-3">
                    {{ form_label(form.plainPassword, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                    {{ form_widget(form.plainPassword) }}
                    {{ form_errors(form.plainPassword) }}
                    {% if user.id %}
                        <small class="text-muted">Deixa en blanc si no vols canviar la contrasenya</small>
                    {% endif %}
                </div>

                {# Roles optional for admin only #}
                {% if form.roles is defined %}
                    <div class="mb-3">
                        {{ form_label(form.roles, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        <div>
                            {% for child in form.roles %}
                                <div class="form-check">
                                    {{ form_widget(child) }}
                                    {{ form_label(child) }}
                                </div>
                            {% endfor %}
                        </div>
                        {{ form_errors(form.roles) }}
                    </div>
                {% endif %}
                
                {# isActive checkbox #}
                {% if form.isActive is defined %}
                    <div class="mb-4">
                        <div class="form-check form-switch">
                            {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input', 'role': 'switch'}}) }}
                            {{ form_label(form.isActive, null, {'label_attr': {'class': 'form-check-label'}}) }}
                        </div>
                    </div>
                {% endif %}
                
                <div class="d-flex justify-content-between">
                    <a href="{{ path('app_admin_users') }}" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left"></i> Tornar
                    </a>
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-check-lg"></i> Guardar
                    </button>
                </div>
                
                {{ form_end(form) }}
            </div>
        </div>
    </div>
</div>
{% endblock %}
