{% extends 'base.html.twig' %}

{% block title %}Dashboard - HomeTab{% endblock %}

{% block body %}
<div class="mb-4">
    <h1 class="display-6">
        <i class="bi bi-house-heart-fill text-primary"></i> 
        Panell d'Usuari
    </h1>
    <p class="lead text-muted">Benvingut a la teva llar: {{ household.name }}</p>
</div>

{# Estadístiques principals #}
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card bg-success text-white h-100">
            <div class="card-body text-center">
                <i class="bi bi-check-circle" style="font-size: 2.5rem;"></i>
                <h2 class="mt-3 mb-1">{{ stats.completedTasks }} / {{ stats.totalTasks }}</h2>
                <p class="mb-0">Tasques completades</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card bg-warning text-white h-100">
            <div class="card-body text-center">
                <i class="bi bi-hourglass-split" style="font-size: 2.5rem;"></i>
                <h2 class="mt-3 mb-1">{{ stats.totalTasks - stats.completedTasks }}</h2>
                <p class="mb-0">Tasques pendents</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card bg-info text-white h-100">
            <div class="card-body text-center">
                <i class="bi bi-coin" style="font-size: 2.5rem;"></i>
                <h2 class="mt-3 mb-1">{{ stats.unpaidExpenses }}</h2>
                <p class="mb-0">Despeses pendents</p>
            </div>
        </div>
    </div>
</div>

{# Estadístiques addicionals #}
<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-primary h-100">
            <div class="card-body text-center">
                <i class="bi bi-calendar-event text-primary" style="font-size: 2rem;"></i>
                <h3 class="mt-3 mb-1">{{ stats.totalEvents }}</h3>
                <p class="text-muted mb-0">Esdeveniments</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card border-success h-100">
            <div class="card-body text-center">
                <i class="bi bi-list-task text-success" style="font-size: 2rem;"></i>
                <h3 class="mt-3 mb-1">{{ stats.totalTasks }}</h3>
                <p class="text-muted mb-0">Total Tasques</p>
            </div>
        </div>
    </div>
    
    <div class="col-md-4">
        <div class="card border-warning h-100">
            <div class="card-body text-center">
                <i class="bi bi-cash-stack text-warning" style="font-size: 2rem;"></i>
                <h3 class="mt-3 mb-1">{{ stats.totalExpenses }}</h3>
                <p class="text-muted mb-0">Total Despeses</p>
            </div>
        </div>
    </div>
</div>

{# Activitat Recent #}
<div class="row g-4 mt-3">
    <div class="col-md-6">
        <div class="card border-success">
            <div class="card-header bg-success text-white">
                <h6 class="mb-0"><i class="bi bi-graph-up"></i> Activitat Recent</h6>
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                        <small class="text-muted">Tasques completades</small>
                        <small class="text-muted">{{ stats.completedTasks }}/{{ stats.totalTasks }}</small>
                    </div>
                    <div class="progress" style="height: 20px;">
                        {% set percentage = stats.totalTasks > 0 ? (stats.completedTasks / stats.totalTasks * 100)|round : 0 %}
                        <div class="progress-bar bg-success" 
                             role="progressbar" 
                             style="width: {{ percentage }}%"
                             aria-valuenow="{{ percentage }}" 
                             aria-valuemin="0" 
                             aria-valuemax="100">
                            {{ percentage }}%
                        </div>
                    </div>
                </div>
                
                <hr>
                
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <span class="text-muted">
                        <i class="bi bi-exclamation-circle text-danger"></i> Despeses pendents
                    </span>
                    <span class="badge bg-danger">{{ stats.unpaidExpenses }}</span>
                </div>
                
                <div class="d-flex justify-content-between align-items-center">
                    <span class="text-muted">
                        <i class="bi bi-check-circle text-success"></i> Despeses pagades
                    </span>
                    <span class="badge bg-success">{{ stats.totalExpenses - stats.unpaidExpenses }}</span>
                </div>
            </div>
        </div>
    </div>
</div>

{% endblock %}
